{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://remotejob.nguyenquocdat.dev/schema/company.schema.json",
  "title": "Remote-first VN company",
  "description": "One entry in data/companies.json. Only public facts. No personal data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["slug", "name", "website", "careers_url", "group", "hq", "remote_policy", "vn_hiring_mode",
               "hires_roles", "timezone_note", "salary_public", "source_urls", "verified", "last_checked"],
  "properties": {
    "slug": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 60,
             "description": "ASCII, lowercase, hyphens. Becomes /cong-ty/<slug>/"},
    "name": {"type": "string", "minLength": 2, "maxLength": 120},
    "website": {"type": ["string", "null"], "pattern": "^https://"},
    "careers_url": {"type": "string", "pattern": "^https?://"},
    "group": {"enum": ["A", "B"], "description": "A = Vietnamese company or VN-based entity that allows remote; B = international company hiring remote in VN"},
    "hq": {"type": "string", "minLength": 2, "maxLength": 200},
    "remote_policy": {"type": "string", "minLength": 3, "maxLength": 400},
    "vn_hiring_mode": {"type": "string", "minLength": 3, "maxLength": 200,
                       "description": "Free text (Vietnamese or English) describing how people in Vietnam are hired: direct hire, EOR, contractor, freelance, via agency/platform, or not verified"},
    "hires_roles": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true,
                    "items": {"type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"}},
    "timezone_note": {"type": "string", "minLength": 2, "maxLength": 200},
    "salary_public": {"type": "string", "maxLength": 200},
    "source_urls": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https?://"}},
    "verified": {"type": "boolean"},
    "last_checked": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
  }
}
